rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ozerojephthah0@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && (request.resource.data.role == 'customer' || (request.resource.data.role == 'owner' && isAdmin()));
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin())
        && request.resource.data.uid == resource.data.uid
        && (isAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // Admin Access Collection
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }

    // Client Projects Collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isValidId(projectId) && isAdmin();
    }

    // Project Enquiries Collection
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId)
        && request.resource.data.keys().hasAll(['id', 'customerName', 'email', 'projectCategory', 'description', 'estimatedBudgetNGN', 'status', 'createdAt'])
        && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 5000;
      allow get, list, update, delete: if isValidId(enquiryId) && isAdmin();
    }

    // Invoices Collection
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isValidId(invoiceId) && isAdmin();
    }
  }
}
